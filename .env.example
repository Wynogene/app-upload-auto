# 复制为 .env 后填写。勿提交真实密钥。
# 默认 = 个人调试安全模式：不改现网、消息只给你自己。

# ========== 安全开关（保持默认即可跑通且不影响现网） ==========
SAFETY_PERSONAL_ONLY=true
FEISHU_WEBHOOK_ENABLED=false
FEISHU_ENABLE_CARD_CALLBACKS=false
# 常驻轮询：true 时配合 apps.yaml schedule.poll_review_status 与 cli.py serve
SCHEDULE_ENABLED=false
HOST=127.0.0.1
PORT=8088

# ========== 飞书（可复用现有应用的 App ID/Secret，只用来「私聊发你」） ==========
# 禁止：修改现网事件订阅 URL；禁止把通知发到业务群
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 调试消息只发给本人（企业 user_id）
FEISHU_OWNER_USER_ID=
# 正式通知名单（盯盘 / 传包 / 提审 / 审核状态）：逗号分隔 user_id
FEISHU_NOTIFY_USER_IDS=
# 仅卡片回调校验操作用；发消息一律走 user_id（可留空）
FEISHU_OWNER_OPEN_ID=
# 群聊字段在 SAFETY_PERSONAL_ONLY=true 时会被忽略
FEISHU_DEFAULT_CHAT_ID=

# ========== Apple / Google（仅本机 secrets/，勿提交） ==========
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# 团队密钥为 AuthKey_XXXXX.p8；个人密钥为 ApiKey_XXXXX.p8（需 sub=user，可留空自动判断）
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXX.p8
# 留空=按文件名自动判断（ApiKey_* → 个人密钥 sub=user；AuthKey_* → 团队密钥不带 sub）
# 也可显式填 "user" 或 "none"
APPLE_TOKEN_SUB=
# ASC 是否走代理。默认 false（直连 api.appstoreconnect.apple.com）
APPLE_USE_PROXY=false
# 飞书是否走代理。默认 false（直连 open.feishu.cn）；本机 HTTP_PROXY=7892 挂了会漏通知
FEISHU_USE_PROXY=false
# 以上为全局（默认）凭据：按 Apple 开发者团队一套。
# 不同公司主体（如 boykeep 是独立团队）需在 config/apps.yaml 的该 App ios 下覆盖
# key_id / issuer_id / private_key_path；留空则回退到这里。
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=secrets/google-play-sa-blurams-easelife.json

# ========== 版本说明默认值（Android releaseNotes / iOS what's New 共用） ==========
# 可被 apps.yaml 的 android.* 覆盖；iOS 提审未单独配置时回退到同一套。
# 语言标签须与商店支持的本地化语言一致，逗号分隔
RELEASE_NOTES_LOCALES=en-US
# 默认文案（运营手工上传时用的那条）。留空则正式版 / iOS 提审必须显式传 --whats-new
RELEASE_NOTES_DEFAULT=- General: Bug fixes and system optimizations.

# 正式版未传 --rollout 时的默认分批百分比（可被 apps.yaml 覆盖）。留空 = 关闭默认分批
ROLLOUT_PERCENT_DEFAULT=5

# ai_support 仓库根目录（可选）：只读 import utils_synology（不改对方代码）
AI_SUPPORT_ROOT=F:\NNE\ai_support

# 群晖分享下载（推荐）：本仓库自实现 FileStation，用于 delivery.vaas.plus/sharing/<id>
SYNOLOGY_BASE_URL=http://delivery.vaas.plus:5000
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=

# serve 定时间隔（分钟）；也可在 apps.yaml schedule.interval_minutes 覆盖
STATUS_POLL_INTERVAL_MINUTES=30
